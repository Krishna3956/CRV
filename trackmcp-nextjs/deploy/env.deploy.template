# Copy this to .env.deploy (in AWS CloudShell) and fill in real values.
# .env.deploy is git-ignored (matches .env*) so secrets never get committed.
#
#   cp deploy/env.deploy.template deploy/.env.deploy
#   nano deploy/.env.deploy        # paste real values
#   bash deploy/apprunner-deploy.sh

# ---- AWS / naming ----
export AWS_REGION="us-east-1"          # pick a region close to your users
export ECR_REPO="trackmcp-web"
export SERVICE_NAME="trackmcp-web"
export IMAGE_TAG="v1"

# ---- Build-time (NEXT_PUBLIC_*) : inlined into the client bundle ----
export NEXT_PUBLIC_SUPABASE_URL=""
export NEXT_PUBLIC_SUPABASE_ANON_KEY=""
export NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=""
export NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
export NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Founder OS derived fact/action-queue writes. Set to "true" only after the
# corresponding Supabase migrations and postflight checks have passed.
export TRACKMCP_ENABLE_FACT_WRITES="false"

# Distributed CLI rate limiting is opt-in. Keep this unset (memory fallback)
# until 20261018000014_rate_limit_buckets.sql and its postflight are complete.
export TRACKMCP_RATE_LIMIT_MODE=""
# App Runner sits behind a trusted edge. Enable only when that edge strips and
# rewrites forwarding headers before requests reach the service.
export TRACKMCP_TRUST_PROXY="false"

# Brevo hosted-form action URL for successful MCP repository submissions.
# This is not an API key. Keep the actual API key exclusively in Brevo.
export BREVO_SUBMIT_FORM_URL=""

# ---- Optional Chinese translation runtime ----
# Leave TRANSLATION_PROVIDER empty to keep the selector fail-closed in English.
# If enabled, add the selected provider key to the JSON secret referenced by
# SECRETS_ARN; the deploy script maps only the selected provider key.
export TRANSLATION_PROVIDER=""       # deepl or google
export DEEPL_API_URL=""              # optional; defaults to DeepL Pro endpoint
export DEEPL_GLOSSARY_ID=""          # optional approved terminology glossary

# ---- Runtime secrets : pulled from AWS Secrets Manager (NOT plaintext env) ----
# Point SECRETS_ARN at a Secrets Manager secret IN THE SAME REGION as the
# service, whose SecretString is JSON with keys GITHUB_TOKEN,
# SUPABASE_SERVICE_ROLE_KEY, TRACKMCP_DEVICE_KEY_DERIVATION_SECRET,
# TRACKMCP_ADMIN_KEY, TRACKMCP_REFRESH_WORKER_SECRET, and
# TRACKMCP_PRIVACY_REVIEW_SECRET, and (when selected) DEEPL_API_KEY or
# GOOGLE_TRANSLATE_API_KEY. The deploy script auto-creates an instance role
# (AppRunnerInstanceRole) allowed to read it and wires them via
# RuntimeEnvironmentSecrets. A pilot deployment fails fast if this is blank.
export SECRETS_ARN=""
