# Copy this to .env.deploy (in AWS CloudShell) and fill in real values.
# .env.deploy is git-ignored (matches .env*) so secrets never get committed.
#
#   cp deploy/env.deploy.template deploy/.env.deploy
#   nano deploy/.env.deploy        # paste real values
#   bash deploy/apprunner-deploy.sh

# ---- AWS / naming ----
export AWS_REGION="us-east-1"          # pick a region close to your users
export ECR_REPO="trackmcp-web"
export SERVICE_NAME="trackmcp-web"
export IMAGE_TAG="v1"

# ---- Build-time (NEXT_PUBLIC_*) : inlined into the client bundle ----
export NEXT_PUBLIC_SUPABASE_URL=""
export NEXT_PUBLIC_SUPABASE_ANON_KEY=""
export NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=""

# ---- Runtime secrets : available only to the server ----
export GITHUB_TOKEN=""
export SUPABASE_SERVICE_ROLE_KEY=""

# ---- Optional runtime keys (leave blank if unused) ----
export TRACKMCP_ADMIN_KEY=""
export TRACKMCP_KEY=""
