{
  "name": "@trackmcp/sdk",
  "version": "0.1.23",
  "description": "Observability SDK for MCP servers",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "observability",
    "analytics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Krishna3956/CRV/tree/main/trackmcp-nextjs/packages/typescript-sdk"
  },
  "homepage": "https://trackmcp.com/docs/typescript",
  "bugs": {
    "url": "https://github.com/Krishna3956/CRV/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client-adapter": {
      "types": "./dist/client-adapter.d.ts",
      "node": "./dist/client-adapter.js",
      "default": null
    },
    "./modern-client": {
      "types": "./dist/modern-client.d.ts",
      "import": "./dist/modern-client.js",
      "default": "./dist/modern-client.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:packed-consumer": "npm run build && node --test test/packed-consumer.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "overrides": {
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^22.20.1",
    "typescript": "^5.0.0",
    "zod": "^4.6.7"
  }
}
